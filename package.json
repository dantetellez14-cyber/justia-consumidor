{
  "name": "justia-consumidor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "scrape:jurisprudencia": "npx tsx scripts/scrape-jurisprudencia.ts",
    "normalize:jurisprudencia": "npx tsx scripts/normalize-jurisprudencia.ts",
    "seed:jurisprudencia": "npx tsx scripts/seed-pinecone.ts --incremental",
    "pipeline:jurisprudencia": "npm run scrape:jurisprudencia && npm run normalize:jurisprudencia && npm run seed:jurisprudencia",
    "db:push": "npx supabase db push",
    "db:new": "npx supabase migration new",
    "migrate:json": "npx tsx scripts/migrate-json-to-supabase.ts"
  },
  "dependencies": {
    "@clerk/localizations": "^4.3.0",
    "@clerk/nextjs": "^7.0.8",
    "@google/generative-ai": "^0.24.1",
    "@pinecone-database/pinecone": "^7.1.0",
    "@sentry/nextjs": "^10.47.0",
    "@supabase/supabase-js": "^2.101.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.8.0",
    "next": "16.2.2",
    "pino": "^10.3.1",
    "playwright": "^1.59.1",
    "posthog-js": "^1.364.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "resend": "^6.10.0",
    "swr": "^2.4.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@clerk/testing": "^2.0.12",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.2",
    "cheerio": "^1.2.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "msw": "^2.13.2",
    "supabase": "^2.91.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.2"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
